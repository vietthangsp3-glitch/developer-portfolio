# Public canonical origin used by Next.js metadata. Use the exact HTTPS origin in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Pooled Neon connection used by the application runtime.
DATABASE_URL=

# Direct Neon connection preferred by Drizzle Kit migrations.
DATABASE_URL_UNPOOLED=

# Better Auth server origin and high-entropy server-only secrets (32+ characters).
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
RATE_LIMIT_HMAC_SECRET=

# Optional in local development; all three are required to enable signed media uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional in every environment. Leave all three empty to store inquiries without
# sending notifications. If enabled, configure all three together; the sender
# must belong to a verified Resend domain.
RESEND_API_KEY=
INQUIRY_NOTIFICATION_EMAIL=
INQUIRY_FROM_EMAIL=

# Required only for authenticated/mutating E2E. The expected host must exactly
# match DATABASE_URL and identify a dedicated Neon development/test target.
E2E_TARGET_CONFIRM=
E2E_EXPECTED_DATABASE_HOST=
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=

# VERCEL_ENV is injected by Vercel. Do not set it in this file.
